---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cartelera from '../components/Cartelera.astro';
import Artistas from '../components/Artistas.astro';
import SeccionesMedia from '../components/SeccionesMedia.astro';
import Testimonios from '../components/Testimonios.astro';
import Entradas from '../components/Entradas.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <main id="main-content">
    <Hero />
    
    <!-- Partners strip -->
    <section class="py-6 border-b border-sf-border bg-sf-bg2/60" aria-label="Partners y patrocinadores oficiales">
      <div class="container mx-auto px-4">
        <p class="text-center text-xs text-sf-muted font-display uppercase tracking-widest mb-5">
          Partners Oficiales
        </p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-14 opacity-50 hover:opacity-100 transition-opacity duration-500">
          <!-- SVG text logos for partners — replaced placeholders with styled spans -->
          <span class="font-heading text-2xl tracking-wider text-sf-kick" aria-label="Kick">KICK</span>
          <span class="font-sans font-bold text-xl text-blue-400" aria-label="Taquillalive">Taquillalive</span>
          <span class="font-sans font-black text-xl italic text-white tracking-tighter" aria-label="Coliseo MedPlus">MedPlus</span>
          <span class="font-heading text-xl text-gray-300" aria-label="Red Bull">RED BULL</span>
          <span class="font-sans font-bold text-xl text-green-500" aria-label="Spotify">Spotify</span>
        </div>
      </div>
    </section>

    <Cartelera />
    <Artistas />
    <SeccionesMedia />
    <Testimonios />
    <Entradas />
    <FAQ />
  </main>

  <Footer />

  <!-- Mobile floating CTA — H-20 fix: no .reveal class -->
  <a
    href="https://taquillalive.com/streamfighters5"
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-5 right-5 z-40 md:hidden
           flex items-center justify-center w-14 h-14
           bg-sf-primary text-white rounded-full shadow-neon-red
           hover:scale-110 transition-transform duration-200
           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
    aria-label="Comprar entradas en Taquillalive"
  >
    <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
    </svg>
  </a>
</Layout>

<script>
  import AOS from 'aos';
  import 'aos/dist/aos.css';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  AOS.init({
    disable: prefersReduced, // Disables AOS entirely if user prefers reduced motion
    once: true,              // Animate only once when scrolling down
    offset: 50,              // Trigger point
    duration: 600,           // Default animation duration
    easing: 'ease-out-cubic',
  });
</script>
