---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title = 'Stream Fighters 5 | La Noche de Boxeo Más Grande de LatAm',
  description = 'Asegura tus entradas para Stream Fighters 5: WestCol vs Blessd. El evento de boxeo con creadores de contenido más épico de Latinoamérica. 14 Nov 2026, Coliseo MedPlus. Transmisión gratis por Kick.',
  ogImage = 'https://images.unsplash.com/photo-1549719228-6567584102b4?q=80&w=1200&auto=format&fit=crop',
  canonicalURL = 'https://streamfighters.com/',
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Stream Fighters 5",
  "startDate": "2026-11-14T17:00:00-05:00",
  "endDate": "2026-11-14T23:59:00-05:00",
  "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": [
    {
      "@type": "Place",
      "name": "Coliseo MedPlus",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle 80 Km 1.5 Vía Cota",
        "addressLocality": "Bogotá",
        "addressRegion": "Cundinamarca",
        "addressCountry": "CO"
      }
    },
    {
      "@type": "VirtualLocation",
      "url": "https://kick.com/westcol"
    }
  ],
  "image": [ogImage],
  "description": "El evento de boxeo con creadores de contenido más importante de Latinoamérica. Pelea estelar: WestCol vs Blessd.",
  "offers": [
    {
      "@type": "Offer",
      "name": "Entrada General",
      "url": "https://taquillalive.com/streamfighters5",
      "price": "90000",
      "priceCurrency": "COP",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-10-01T00:00:00-05:00"
    },
    {
      "@type": "Offer",
      "name": "VIP Ring Side",
      "url": "https://taquillalive.com/streamfighters5",
      "price": "250000",
      "priceCurrency": "COP",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-10-01T00:00:00-05:00"
    }
  ],
  "performer": [
    { "@type": "Person", "name": "WestCol", "sameAs": "https://kick.com/westcol" },
    { "@type": "Person", "name": "Blessd" },
    { "@type": "Person", "name": "Kris R" }
  ],
  "organizer": {
    "@type": "Organization",
    "name": "WestCol",
    "url": "https://kick.com/westcol",
    "sameAs": ["https://kick.com/westcol", "https://www.instagram.com/westcol/"]
  }
};
---

<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A0A0A" />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Stream Fighters 5, WestCol, Blessd, boxeo creadores de contenido, evento Kick Colombia, Coliseo MedPlus, Taquillalive, Kris R" />
  <meta name="author" content="WestCol & Equipo Stream Fighters" />
  <meta name="robots" content="index, follow" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content="Stream Fighters 5 | WestCol vs Blessd" />
  <meta property="og:description" content="10 combates, shows musicales y tecnología robótica. 14 de Noviembre, Coliseo MedPlus. Transmisión gratis por Kick." />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="Stream Fighters" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@StreamFighters" />
  <meta name="twitter:title" content="Stream Fighters 5 | WestCol vs Blessd" />
  <meta name="twitter:description" content="10 combates, shows musicales y tecnología robótica. 14 Nov, Coliseo MedPlus. Transmisión gratis por Kick." />
  <meta name="twitter:image" content={ogImage} />

  <!-- Security Meta -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
    rel="stylesheet"
  />

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <!-- Noise texture overlay (decorative, hidden from AT) -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <slot />
</body>
</html>
