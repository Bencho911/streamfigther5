---
import { Image } from 'astro:assets';
import imgKrisR from '../assets/peleadores/Krisr.png';

const artists = [
  {
    name: 'Kris R',
    genre: 'Urbano · Reggaeton',
    role: 'Artista Principal',
    roleColor: 'text-sf-secondary',
    img: imgKrisR,
    imgAlt: 'Artista de música urbana en concierto — representación de Kris R en Stream Fighters 5',
    sizes: '(max-width: 768px) 50vw, 25vw',
    srcset: 'https://images.unsplash.com/photo-1493225457124-a1a2a5f5f464?q=80&w=300&auto=format 300w, https://images.unsplash.com/photo-1493225457124-a1a2a5f5f464?q=80&w=600&auto=format 600w',
  },
  {
    name: 'Blessd',
    genre: 'Reggaeton · Trap',
    role: 'Show post-pelea',
    roleColor: 'text-sf-primary',
    img: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=600&auto=format&fit=crop',
    imgAlt: 'Artista de reggaeton en escenario — representación de Blessd en Stream Fighters 5',
    sizes: '(max-width: 768px) 50vw, 25vw',
    srcset: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=300&auto=format 300w, https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=600&auto=format 600w',
  },
  {
    name: 'Artista',
    genre: 'Por confirmar',
    role: 'Fase 2',
    roleColor: 'text-sf-muted',
    placeholder: true,
  },
  {
    name: 'Special Guest',
    genre: 'Sorpresa',
    role: 'Reveal próximamente',
    roleColor: 'text-sf-muted',
    placeholder: true,
  },
];
---

<section
  id="artistas"
  class="py-24 bg-sf-bg2 relative border-y border-sf-border/50"
  aria-labelledby="artistas-heading"
>
  <!-- Radial purple glow -->
  <div
    class="absolute right-0 top-0 w-1/2 h-full pointer-events-none"
    style="background: radial-gradient(ellipse at right, rgba(122,0,255,0.10) 0%, transparent 60%)"
    aria-hidden="true"
  ></div>

  <div class="container mx-auto px-4 relative z-10">

    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <div data-aos="fade-up">
        <h2 id="artistas-heading" class="font-heading text-4xl md:text-5xl text-white uppercase tracking-tight mb-2">
          La música también pelea
        </h2>
        <p class="text-sf-muted text-lg font-medium">Shows en vivo que harán vibrar el Coliseo.</p>
      </div>
      <div class="shrink-0 text-sf-secondary font-display text-sm border border-sf-secondary/30 bg-sf-secondary/10 px-4 py-2 rounded-full" data-aos="fade-left">
        Lineup Oficial
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {artists.map((artist, i) => (
        artist.placeholder ? (
          <div
            class=" bg-sf-surface border border-sf-border border-dashed rounded-xl aspect-[3/4]
                   flex flex-col items-center justify-center p-6 text-center"
            data-aos="fade-up"
            data-aos-delay={i * 100}
            aria-label={`${artist.name}: ${artist.genre}`}
          >
            <svg class="w-10 h-10 text-sf-border mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <h3 class="font-heading text-xl text-sf-muted uppercase leading-tight">{artist.name}</h3>
            <p class={`text-xs mt-2 font-display ${artist.roleColor}`}>{artist.role}</p>
          </div>
        ) : (
          <div
            class=" group relative overflow-hidden rounded-xl aspect-[3/4]"
            data-aos="fade-up"
            data-aos-delay={i * 100}
          >
            <Image
              src={artist.img}
              width={600}
              height={800}
              format="webp"
              alt={artist.imgAlt}
              loading="lazy"
              class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-sf-bg via-sf-bg/40 to-transparent
                     opacity-80 group-hover:opacity-100 transition-opacity"
              aria-hidden="true"
            ></div>
            <div
              class="absolute bottom-0 left-0 w-full p-4 md:p-6 transform translate-y-3 group-hover:translate-y-0 transition-transform duration-300"
            >
              <p class={`${artist.roleColor} font-display text-xs uppercase tracking-wider mb-1`}>
                {artist.genre}
              </p>
              <h3 class="font-heading text-2xl text-white uppercase leading-none">{artist.name}</h3>
              <p class="text-sf-muted text-xs mt-1 font-display">{artist.role}</p>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>
