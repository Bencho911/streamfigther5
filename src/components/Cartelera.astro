---
import { Image } from 'astro:assets';
import { fights } from '../data/fights';

const mainEvent = fights[0];
const undercard = fights.slice(1);

// Clases ESTÁTICAS por labelColor — el scanner de Tailwind las detecta
function getLabelClass(color: string): string {
  if (color === 'red')    return 'bg-sf-primary text-white';
  if (color === 'purple') return 'bg-sf-secondary text-white';
  if (color === 'gold')   return 'bg-sf-tertiary text-sf-bg';
  return 'bg-sf-surface border border-sf-border text-sf-muted';
}
---

<section id="cartelera" class="py-24 relative" aria-labelledby="cartelera-heading">
  <!-- Decorative top gradient -->
  <div class="absolute top-0 left-0 right-0 h-48 bg-gradient-to-b from-sf-bg to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Heading -->
    <div class="text-center mb-16 " data-aos="fade-up">
      <h2 id="cartelera-heading" class="font-heading text-4xl md:text-5xl lg:text-6xl text-white uppercase tracking-tight mb-4">
        Cartelera Oficial
      </h2>
      <p class="text-sf-muted text-lg font-medium">10 combates. Una sola noche. Sin excusas.</p>
    </div>

    <!-- ── Main Event Card ── -->
    <div class=" mb-14" data-aos="zoom-in" data-aos-delay="100">
      <a
        href={`/pelea/${mainEvent.id}`}
        class="block relative bg-gradient-to-b from-sf-surface to-sf-bg border border-sf-primary/50 rounded-2xl overflow-hidden
               shadow-surface hover:shadow-neon-red transition-all duration-500 group"
        aria-label={`Pelea estelar: ${mainEvent.fighter1.name} vs ${mainEvent.fighter2.name}`}
      >
        {mainEvent.posterImage && (
          <div class="absolute inset-0 opacity-20 mix-blend-luminosity group-hover:opacity-30 group-hover:scale-105 transition-all duration-700 pointer-events-none">
            <Image src={mainEvent.posterImage} alt="" class="w-full h-full object-cover object-[center_25%]" />
          </div>
        )}

        <!-- Label -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 bg-sf-primary text-white font-display font-bold px-6 py-1 rounded-b-lg text-xs tracking-widest uppercase z-20">
          {mainEvent.label}
        </div>

        <div class="relative z-10 p-6 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">

          <!-- Fighter 1 -->
          <div class="flex-1 text-center md:text-right">
            <h3 class="font-heading text-5xl md:text-7xl uppercase text-white text-glow mb-2">
              {mainEvent.fighter1.name}
            </h3>
            <p class="text-sf-primary font-display text-sm uppercase tracking-widest">
              {mainEvent.fighter1.nickname}
            </p>
            <div class="mt-4 inline-block bg-sf-bg2 px-4 py-2 rounded border border-sf-border text-left">
              <p class="text-xs text-sf-muted uppercase mb-0.5">Tecnología</p>
              <p class="font-display text-white text-sm">Brazo Biomecánico V2</p>
            </div>
          </div>

          <!-- VS -->
          <div class="shrink-0 flex flex-col items-center">
            <span class="font-heading text-6xl md:text-8xl text-white/10 italic leading-none drop-shadow-lg" aria-hidden="true">VS</span>
            <span class="text-sf-muted text-xs mt-2 font-display border border-sf-border rounded-full px-3 py-1">
              {mainEvent.weight}
            </span>
          </div>

          <!-- Fighter 2 -->
          <div class="flex-1 text-center md:text-left">
            <h3 class="font-heading text-5xl md:text-7xl uppercase text-white text-glow mb-2">
              {mainEvent.fighter2.name}
            </h3>
            <p class="text-sf-secondary font-display text-sm uppercase tracking-widest">
              {mainEvent.fighter2.nickname}
            </p>
            <div class="mt-4 inline-block bg-sf-bg2 px-4 py-2 rounded border border-sf-border text-left">
              <p class="text-xs text-sf-muted uppercase mb-0.5">Tecnología</p>
              <p class="font-display text-white text-sm">Exoesqueleto Inferior</p>
            </div>
          </div>
        </div>

        <div class="bg-sf-primary/10 border-t border-sf-primary/20 p-4 text-center relative z-10 group-hover:bg-sf-primary/20 transition-colors">
          <p class="text-white font-medium text-sm flex items-center justify-center gap-2">
            {mainEvent.description}
            <span class="text-sf-primary group-hover:translate-x-1 transition-transform font-bold">→</span>
          </p>
        </div>
      </a>
    </div>

    <!-- ── Undercard Grid ── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {undercard.map((fight, i) => (
        <a
          href={`/pelea/${fight.id}`}
          class="block fighter-card bg-sf-surface rounded-xl overflow-hidden group hover:border-sf-border transition-colors border border-transparent"
          data-aos="fade-up"
          data-aos-delay={(i % 3) * 100}
          aria-label={`Combate ${fight.id}: ${fight.fighter1.name} vs ${fight.fighter2.name}${fight.fighter3 ? ' vs ' + fight.fighter3.name : ''}`}
        >
          <!-- Card header gradient / Image -->
          <div class="h-36 relative overflow-hidden bg-sf-bg2" aria-hidden="true">
            {fight.posterImage ? (
              <Image src={fight.posterImage} alt="" class="absolute inset-0 w-full h-full object-cover object-[center_25%] opacity-60 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-110" />
            ) : (
              <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${fight.gradient})`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-sf-surface to-transparent"></div>

            <!-- Fight number badge -->
            <span class="absolute top-3 right-3 font-display text-xs font-bold text-sf-muted border border-sf-border bg-sf-bg/80 rounded-full px-2 py-0.5">
              #{fight.id}
            </span>

            <!-- Label badge -->
            <span class={`absolute top-3 left-3 text-xs font-display font-bold px-2.5 py-0.5 rounded-full ${getLabelClass(fight.labelColor)}`}>
              {fight.label}
            </span>
          </div>

          <div class="p-5 text-center">
            <p class="text-sf-primary font-display text-xs uppercase tracking-widest mb-2">
              {fight.weight}
            </p>

            {fight.fighter3 ? (
              <h3 class="font-heading text-lg uppercase mb-1 leading-tight">
                {fight.fighter1.name}
                <span class="text-sf-muted text-sm mx-1.5">vs</span>
                {fight.fighter2.name}
                <span class="text-sf-muted text-sm mx-1.5">vs</span>
                {fight.fighter3.name}
              </h3>
            ) : (
              <h3 class="font-heading text-xl uppercase mb-1">
                {fight.fighter1.name}
                <span class="text-sf-muted text-base mx-2">vs</span>
                {fight.fighter2.name}
              </h3>
            )}

            <p class="text-sm text-sf-muted mt-2 leading-relaxed">{fight.description}</p>
            <p class="text-xs text-sf-primary font-bold mt-4 opacity-0 group-hover:opacity-100 transition-opacity">Ver Pronóstico →</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Taquillalive CTA under cartelera -->
    <div class="mt-12 text-center " data-aos="fade-up">
      <a
        href="https://taquillalive.com/streamfighters5"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-bold text-white bg-sf-primary px-8 py-4 rounded-full
               hover:bg-red-700 hover:shadow-neon-red transition-all duration-200
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sf-primary"
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
        </svg>
        Comprar entradas en Taquillalive
      </a>
    </div>
  </div>
</section>
