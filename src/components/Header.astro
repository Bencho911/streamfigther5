---
// Header — sticky, responsive, accessible
const navLinks = [
  { href: '/#cartelera', label: 'Cartelera' },
  { href: '/#artistas',  label: 'Artistas'  },
  { href: '/#como-ver', label: 'Cómo ver'  },
  { href: '/#historia', label: 'Historia'  },
  { href: '/#faq',      label: 'FAQ'       },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 py-4 px-6 md:px-12 border-b border-transparent"
>
  <div class="max-w-7xl mx-auto flex justify-between items-center">

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-1 z-50 group rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sf-primary"
      aria-label="Stream Fighters 5 — Ir al inicio"
    >
      <span class="font-heading text-2xl md:text-3xl tracking-wide uppercase leading-none">
        Stream Fighters
      </span>
      <span
        class="font-heading text-3xl md:text-4xl text-sf-primary text-glow-red
               transition-transform duration-200 group-hover:scale-110 leading-none"
      >5</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      <ul class="flex gap-6 font-medium text-sm text-sf-muted" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="hover:text-white transition-colors duration-150
                     focus-visible:outline-none focus-visible:text-white
                     focus-visible:underline focus-visible:underline-offset-4"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3">
        <a
          href="https://kick.com/westcol"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm font-bold text-sf-bg bg-sf-kick px-5 py-2.5 rounded-full
                 hover:shadow-neon-green hover:scale-105 transition-all duration-200
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sf-kick focus-visible:ring-offset-2 focus-visible:ring-offset-sf-bg"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M21 3.5v17h-4v-5h-3v5H3v-17h11v5h3v-5h4Zm-8 12v-5h3v5h-3Z"/>
          </svg>
          Ver en Kick
        </a>
        <a
          href="https://taquillalive.com/streamfighters5"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-bold text-white bg-sf-primary px-5 py-2.5 rounded-full
                 hover:bg-red-700 hover:shadow-neon-red hover:scale-105 transition-all duration-200
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sf-primary focus-visible:ring-offset-2 focus-visible:ring-offset-sf-bg"
        >
          Comprar entradas
        </a>
      </div>
    </nav>

    <!-- Mobile toggle -->
    <button
      id="menu-btn"
      class="lg:hidden z-50 text-white p-2 rounded
             focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sf-primary"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-sf-bg/95 backdrop-blur-md flex flex-col justify-center items-center gap-8 lg:hidden"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación móvil"
  >
    <ul class="flex flex-col gap-6 text-center text-2xl font-heading tracking-wide" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="mobile-link hover:text-sf-primary transition-colors focus-visible:outline-none focus-visible:text-sf-primary"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href="/#entradas" class="mobile-link text-sf-primary hover:text-sf-primary/80 transition-colors">
          Entradas
        </a>
      </li>
    </ul>
    <div class="flex flex-col gap-3 w-64 mt-4">
      <a
        href="https://kick.com/westcol"
        target="_blank"
        rel="noopener noreferrer"
        class="text-center font-bold text-sf-bg bg-sf-kick px-6 py-3.5 rounded-full
               hover:shadow-neon-green transition-all"
      >
        Ver en Kick
      </a>
      <a
        href="https://taquillalive.com/streamfighters5"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-link text-center font-bold text-white bg-sf-primary px-6 py-3.5 rounded-full
               hover:bg-red-700 transition-all"
      >
        Comprar entradas
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn    = document.getElementById('menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconOpen   = document.getElementById('icon-open')!;
  const iconClose  = document.getElementById('icon-close')!;
  const navbar     = document.getElementById('navbar')!;
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-link');

  function toggleMenu() {
    const isOpen = mobileMenu.classList.contains('open');

    if (isOpen) {
      mobileMenu.classList.remove('open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      document.body.style.overflow = '';
    } else {
      mobileMenu.classList.add('open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
      menuBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      document.body.style.overflow = 'hidden';
    }
  }

  menuBtn.addEventListener('click', toggleMenu);

  // Close on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu.classList.contains('open')) toggleMenu();
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu.classList.contains('open')) toggleMenu();
  });

  // Sticky header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar.style.backgroundColor = 'rgba(10,10,10,0.92)';
      navbar.style.backdropFilter = 'blur(12px)';
      navbar.style.borderBottomColor = 'var(--color-sf-border)';
      navbar.style.boxShadow = '0 4px 24px rgba(0,0,0,0.4)';
    } else {
      navbar.style.backgroundColor = '';
      navbar.style.backdropFilter = '';
      navbar.style.borderBottomColor = 'transparent';
      navbar.style.boxShadow = '';
    }
  }, { passive: true });
</script>
